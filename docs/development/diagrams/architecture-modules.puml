@startuml
package leaves {
  [_env]
  [_timestamp]
  [_footmark_wire]
  [_s3_client]
  [_capabilities]
  [hexdigest]
  [metrics]
}
[base] --> [hexdigest]
[base] --> [metrics]
[url] --> [base]
[_reserved] --> [base]
[_fs_paths] --> [base]
[_s3_acl] --> [base]
[_s3_acl] --> [_s3_client]
[_s3_errors] --> [base]
[_s3_errors] --> [_s3_client]
[_s3_lock] --> [base]
[_s3_lock] --> [_s3_client]
[_s3_lock] --> [_s3_errors]
[footmark] --> [_footmark_wire]
[footmark] --> [_timestamp]
[transaction] --> [base]
[transaction] --> [footmark]
[transaction] --> [_reserved]
[transaction] --> [_reclaim]
[_reclaim] --> [footmark]
[_reclaim] --> [_reserved]
[history] --> [base]
[history] --> [footmark]
[history] --> [_timestamp]
[history] --> [transaction]
[history] --> [_env]
[history] --> [_reserved]
[storage_fs] --> [transaction]
[storage_fs] --> [_fs_paths]
[storage_fs] --> [_reserved]
[storage_s3] --> [transaction]
[storage_s3] --> [_s3_client]
[storage_s3] --> [_s3_acl]
[storage_s3] --> [_s3_errors]
[storage_s3] --> [_s3_lock]
[storage_s3] --> [_reserved]
[storage_http] --> [_capabilities]
[storage_null] --> [_capabilities]
[factory] --> [storage_fs]
[factory] --> [storage_s3]
[factory] --> [storage_http]
[factory] --> [_env]
[factory] --> [_s3_client]
@enduml
